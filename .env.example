# Copy to .env and adjust for your machine. .env is git-ignored on purpose:
# host ports differ per box, the committed defaults stay canonical.

# Host-side published ports (container ports are always 4000/4001).
FRONTEND_PORT=4000
BACKEND_PORT=4001

# Optional backend limits (defaults shown).
# MAX_AUDIO_MINUTES=15
# LINKIMPORT_CONCURRENCY=2
# AUDIO_CACHE_MB=1024
# AUDIO_CACHE_FILES=100

# Residential proxy for YouTube downloads (only needed for server-side link
# import — uploads never touch the server). Datacenter IPs get HTTP 403 on
# media even with valid cookies. Any residential HTTP/HTTPS/SOCKS5 proxy
# works, e.g. YTDLP_PROXY=http://user:pass@host:port or
# YTDLP_PROXY=socks5://user:pass@host:port — keep this in .env, never commit.
# YTDLP_PROXY=

# Optional: explicit cookie path override (auto-detection of
# backend/data/cookies.txt needs no setting at all).
# YTDLP_COOKIES_FILE=/app/data/cookies.txt
# Port for the production frontend image (docker compose --profile prod).
# FRONTEND_PROD_PORT=4200
