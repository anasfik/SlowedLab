# Copy to .env and adjust for your machine. .env is git-ignored on purpose:
# host ports differ per box, the committed defaults stay canonical.

# Host-side published ports (container ports are always 4000/4001).
FRONTEND_PORT=4000
BACKEND_PORT=4001

# Optional backend limits (defaults shown).
# MAX_AUDIO_MINUTES=15
# LINKIMPORT_CONCURRENCY=2
# AUDIO_CACHE_MB=1024
# AUDIO_CACHE_FILES=100

# Optional: uncomment when YouTube serves bot-checks/403s, then mount a
# Netscape cookies.txt at backend/data/cookies.txt and add
# YTDLP_COOKIES_FILE=/app/data/cookies.txt to docker-compose.yml.
# YTDLP_COOKIES_FILE=/app/data/cookies.txt
# Port for the production frontend image (docker compose --profile prod).
# FRONTEND_PROD_PORT=4200
