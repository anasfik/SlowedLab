# Local frontend dev settings (CRA only reads .env.local).
# Copy to .env.local: cp .env.local.example .env.local

# Dev server port. CRA defaults to 3000 when unset.
# PORT=3000

# The dev server proxies same-origin /api/* to the backend.
# Override only if you run the backend elsewhere (see src/setupProxy.js).
# BACKEND_PROXY_URL=http://localhost:4001

# OpenAI API key for the (experimental) AI preset recommender.
# Get a key at https://platform.openai.com/api-keys
# REACT_APP_OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE