# Production image for the frontend: build once, serve statically.
#
#   docker compose --profile prod up -d --build frontend-prod
#
# The bundle contains no environment-specific API host (the app always calls
# same-origin /api/*), so one image works on any host or domain.

# ---- build stage ----
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# No REACT_APP_* values are required: everything is same-origin at runtime.
ENV GENERATE_SOURCEMAP=false
RUN npm run build

# ---- runtime stage ----
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]